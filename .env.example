# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
# local | production. Production requires INTERNAL_SHARED_SECRET, DB_PASSWORD
# and REDIS_PASSWORD, and protects /metrics and /swagger with the secret.
APP_ENV=local
PORT=8080
# Empty = stdout only. Otherwise logs also rotate into <LOG_DIR>/<mode>.log.
LOG_DIR=
# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
# Must be shorter than the container stop_grace_period.
HTTP_SHUTDOWN_TIMEOUT=20s
# Maximum request body in bytes (default 5 MiB).
HTTP_MAX_BODY_BYTES=5242880
# Comma-separated browser origins. Leave empty: the frontend reaches the API
# through its own server-side proxy, so no browser origin needs access.
CORS_ALLOWED_ORIGINS=
# Proxies allowed to set X-Forwarded-For (comma-separated IPs or CIDR ranges).
# Empty trusts none, so the client IP is the TCP peer and cannot be spoofed.
TRUSTED_PROXIES=
# Header set by a trusted edge platform holding the real client IP, for example
# CF-Connecting-IP behind Cloudflare. Only set it when every request passes
# through that platform.
TRUSTED_PLATFORM=

# Rate limits (GCRA). Each policy allows RATE_LIMIT_<NAME> requests per
# RATE_LIMIT_<NAME>_PERIOD, with up to RATE_LIMIT_<NAME>_BURST at once.
# A limit of 0 disables the policy.
#   ip              every /api/v1 request, per client IP
#   auth            register/login/refresh, per client IP
#   login_account   failed logins, per account
#   user            authenticated requests, per user
#   api_client      requests with an API key, per client
#   resume_upload   resume uploads, per user
#   contact_enrich  enrichment requests, per user (each spends paid credits)
RATE_LIMIT_IP=1200
RATE_LIMIT_IP_PERIOD=1m
RATE_LIMIT_IP_BURST=200
RATE_LIMIT_AUTH=10
RATE_LIMIT_AUTH_PERIOD=1m
RATE_LIMIT_AUTH_BURST=10
RATE_LIMIT_LOGIN_ACCOUNT=10
RATE_LIMIT_LOGIN_ACCOUNT_PERIOD=1h
RATE_LIMIT_LOGIN_ACCOUNT_BURST=5
RATE_LIMIT_USER=600
RATE_LIMIT_USER_PERIOD=1m
RATE_LIMIT_USER_BURST=100
RATE_LIMIT_API_CLIENT=1200
RATE_LIMIT_API_CLIENT_PERIOD=1m
RATE_LIMIT_API_CLIENT_BURST=300
RATE_LIMIT_RESUME_UPLOAD=20
RATE_LIMIT_RESUME_UPLOAD_PERIOD=24h
RATE_LIMIT_RESUME_UPLOAD_BURST=10
RATE_LIMIT_CONTACT_ENRICH=30
RATE_LIMIT_CONTACT_ENRICH_PERIOD=24h
RATE_LIMIT_CONTACT_ENRICH_BURST=10

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16 + pgvector)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=autoreach
DB_PASSWORD=autoreach
DB_NAME=autoreach
# search_path is set to "<DB_SCHEMA>,public"; the vector extension lives in public.
DB_SCHEMA=autoreach
DB_SSLMODE=disable
DB_MAX_CONNS=20
DB_STATEMENT_TIMEOUT=15s
DB_LOCK_TIMEOUT=5s

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=autoreach
REDIS_DB=0

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Sent as X-Internal-Secret to reach /metrics and /swagger in production.
INTERNAL_SHARED_SECRET=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# HS256 signing key for access tokens. Required in every environment, at least
# 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# ---------------------------------------------------------------------------
# Table names (override only if a deployment names tables differently)
# ---------------------------------------------------------------------------
# DB_TABLE_USERS=users
# DB_TABLE_REFRESH_TOKENS=refresh_tokens
# DB_TABLE_CANDIDATES=candidates
# DB_TABLE_API_CLIENTS=api_clients
# DB_TABLE_JOB_POSTINGS=job_postings

# ---------------------------------------------------------------------------
# Worker and scheduler
# ---------------------------------------------------------------------------
WORKER_MESSAGE_PROVIDER=asynq
WORKER_CONCURRENCY=10
# Defaults to WORKER_CONCURRENCY + 5 so every running task can hold a connection.
# WORKER_DB_MAX_CONNS=15
# Must be shorter than the container stop_grace_period.
WORKER_SHUTDOWN_TIMEOUT=25s
# Embedding tasks are folded into one OpenAI call: flush at this many jobs,
# or after MAX_DELAY, or once no new task arrived for GRACE_PERIOD
# (values below 1s are raised to 1s; the queue library rejects less).
WORKER_EMBED_GROUP_MAX_SIZE=64
WORKER_EMBED_GROUP_MAX_DELAY=10s
WORKER_EMBED_GROUP_GRACE_PERIOD=2s
CRON_STOP_GRACE_PERIOD=20s
# Re-enqueues rows whose task was lost (for example a publish that failed
# after the database commit). STALE_AFTER must exceed normal queue latency.
RECONCILER_INTERVAL=5m
RECONCILER_STALE_AFTER=5m
RECONCILER_BATCH_SIZE=500

# ---------------------------------------------------------------------------
# OpenAI embeddings
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector(1536) columns.
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT=30s
# Inputs are truncated to stay under the 8,191-token limit of the model.
OPENAI_EMBEDDING_MAX_INPUT_CHARS=24000

# ---------------------------------------------------------------------------
# Admin bootstrap (only read by: autoreach create-admin <email>)
# ---------------------------------------------------------------------------
# ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Concurrency
# ---------------------------------------------------------------------------
# Fire-and-forget work (utils.RunInBackground). When all slots are busy the
# work runs inline on the caller, which applies backpressure.
BACKGROUND_MAX_GOROUTINES=64
# How long shutdown waits for background work before closing the pools.
BACKGROUND_DRAIN_TIMEOUT=15s
# Fan-out width of utils.RunConcurrently. Keep below DB_MAX_CONNS.
CONCURRENT_TASK_LIMIT=16
# DB_TABLE_CANDIDATE_RESUMES=candidate_resumes
# DB_TABLE_JOB_MATCHES=job_matches

# ---------------------------------------------------------------------------
# Resumes and matching
# ---------------------------------------------------------------------------
# Must stay below HTTP_MAX_BODY_BYTES to leave room for multipart framing.
RESUME_MAX_BYTES=4194304
# Guard against documents that expand to huge text (zip bombs).
RESUME_MAX_TEXT_CHARS=200000
# Jobs considered per resume. EF_SEARCH is raised to at least TOP_K, because
# pgvector returns at most ef_search rows from an HNSW scan (default 40).
MATCH_TOP_K=50
MATCH_EF_SEARCH=100
# Matches scoring below min(candidate threshold, this floor) are not stored.
MATCH_MIN_STORED_SCORE=0.50
# matchScore = clamp((cosineSimilarity - LOW) / (HIGH - LOW), 0, 1).
# 0 and 1 leave the raw similarity unchanged. Set from a labelled sample:
# raw resume-to-job similarity rarely reaches 0.80 with this embedding model.
MATCH_CALIBRATION_LOW=0
MATCH_CALIBRATION_HIGH=1
# DB_TABLE_COMPANY_CONTACTS=company_contacts
# DB_TABLE_JOB_CONTACTS=job_contacts
# DB_TABLE_ENRICHMENT_REQUESTS=enrichment_requests

# ---------------------------------------------------------------------------
# Contact enrichment
# ---------------------------------------------------------------------------
# Waterfall order. A provider without an API key is skipped.
ENRICHMENT_PROVIDERS=APOLLO,SIGNALHIRE,CONTACTOUT
# Per call. The whole task has 30s, so keep this well below it.
ENRICHMENT_HTTP_TIMEOUT=8s
ENRICHMENT_MAX_CONTACTS_PER_JOB=3
ENRICHMENT_PEOPLE_PER_SEARCH=10
# Contacts already known for a company are reused for this long, so the same
# person is not bought again for every opening at that company.
ENRICHMENT_CONTACT_FRESHNESS=720h
# A provider is paused for COOLDOWN after a 429, or when more than
# FAILURE_RATE of at least MIN_REQUESTS calls in WINDOW returned 5xx.
ENRICHMENT_BREAKER_WINDOW=1m
ENRICHMENT_BREAKER_COOLDOWN=1m
ENRICHMENT_BREAKER_MIN_REQUESTS=20
ENRICHMENT_BREAKER_FAILURE_RATE=0.05
ENRICHMENT_MX_LOOKUP_TIMEOUT=3s

APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/api/v1
APOLLO_RATE_LIMIT=50
APOLLO_RATE_WINDOW=1m
# Calls allowed at once before the rest are spaced evenly over the window.
APOLLO_RATE_BURST=10
# Paid lookups allowed per UTC day. 0 disables the budget.
APOLLO_DAILY_CREDITS=200

SIGNALHIRE_API_KEY=
SIGNALHIRE_BASE_URL=https://www.signalhire.com/api/v1
SIGNALHIRE_RATE_LIMIT=50
SIGNALHIRE_RATE_WINDOW=1m
SIGNALHIRE_RATE_BURST=10
SIGNALHIRE_DAILY_CREDITS=200
# SignalHire answers asynchronously by calling back. Both values are required
# for it to be used: the public URL of this API and a secret for the callback.
PUBLIC_BASE_URL=
SIGNALHIRE_WEBHOOK_SECRET=

CONTACTOUT_API_KEY=
CONTACTOUT_BASE_URL=https://api.contactout.com/v1
CONTACTOUT_RATE_LIMIT=50
CONTACTOUT_RATE_WINDOW=1m
CONTACTOUT_RATE_BURST=10
CONTACTOUT_DAILY_CREDITS=200

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# local | s3. With s3, the S3_* settings below are required and startup fails
# if the bucket cannot be reached. Any other value also stops startup.
STORAGE_DRIVER=local
# Used only when STORAGE_DRIVER=local.
STORAGE_LOCAL_DIR=./data/uploads

# Used only when STORAGE_DRIVER=s3.
S3_BUCKET=
S3_REGION=us-east-1
# Leave empty for AWS. Set for S3-compatible services (Cloudflare R2, MinIO).
S3_ENDPOINT=
# Leave both empty to use the AWS default credential chain (IAM role, profile).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and most self-hosted services; false for AWS and R2.
S3_USE_PATH_STYLE=false
# AES256 (S3-managed keys), aws:kms, or empty to rely on the bucket default.
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_TIMEOUT=15s
