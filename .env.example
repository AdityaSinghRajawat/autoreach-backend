# =============================================================================
# AutoReach backend configuration
# =============================================================================
# Copy this file to .env and adjust it. The server and the worker read the same
# file (and real environment variables, which take precedence).
#
# To run locally with `make dev-up`, the defaults below already match the dev
# Postgres and Redis. You only need to set:
#
#   JWT_SECRET       any random string of 32+ characters (openssl rand -base64 48)
#   AI_API_KEY       needed for embeddings, so resumes and jobs can be matched
#
# Everything else is optional and only matters for the feature it belongs to:
# enrichment provider keys, mailbox encryption keys, job board keys, S3 and so on.
#
# Production (APP_ENV=production) additionally requires INTERNAL_SHARED_SECRET,
# CHANNEL_CREDENTIAL_KEYS and real DB/Redis passwords; see docs/RUNBOOK.md.
#
# Durations use Go syntax: 500ms, 30s, 15m, 24h. 720h is 30 days.
#
# Sections:
#    1. Application               10. Resumes and matching
#    2. HTTP server               11. Job sources
#    3. Rate limits               12. Contact enrichment
#    4. PostgreSQL                13. Email outreach
#    5. Redis                     14. LinkedIn outreach
#    6. Authentication            15. Job applications
#    7. Worker and scheduler      16. Dashboard
#    8. Background concurrency    17. Privacy
#    9. AI provider               18. File storage
#                                 19. Admin bootstrap
#                                 20. Table name overrides


# -----------------------------------------------------------------------------
# 1. Application
# -----------------------------------------------------------------------------
# local | production. Production requires INTERNAL_SHARED_SECRET, DB_PASSWORD,
# REDIS_PASSWORD and CHANNEL_CREDENTIAL_KEYS, and protects /metrics and
# /swagger with the internal secret.
APP_ENV=local
# Port of the API server, and of the worker's /health and /metrics endpoint.
# Running both locally? Start the worker with PORT=8081.
PORT=8080
# Empty = stdout only. Otherwise logs also rotate into <LOG_DIR>/<mode>.log.
LOG_DIR=
# debug | info | warn | error
LOG_LEVEL=info
# Public https address of this API. Links in outreach emails (one-click
# unsubscribe, open and click tracking) and the SignalHire callback point here.
# Leave empty locally: emails then carry only a mailto: unsubscribe, tracking is
# off and SignalHire is not used.
PUBLIC_BASE_URL=
# Sent as the X-Internal-Secret header to reach /metrics and /swagger in
# production. Generate with: openssl rand -hex 24
INTERNAL_SHARED_SECRET=


# -----------------------------------------------------------------------------
# 2. HTTP server
# -----------------------------------------------------------------------------
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
# Must be shorter than the container stop_grace_period (45s in Compose).
HTTP_SHUTDOWN_TIMEOUT=20s
# Maximum request body in bytes (default 5 MiB).
HTTP_MAX_BODY_BYTES=5242880
# Comma-separated browser origins. Leave empty: the frontend reaches the API
# through its own server-side proxy, so no browser origin needs access.
CORS_ALLOWED_ORIGINS=
# Proxies allowed to set X-Forwarded-For (comma-separated IPs or CIDR ranges).
# Empty trusts none, so the client IP is the TCP peer and cannot be spoofed.
TRUSTED_PROXIES=
# Header set by a trusted edge platform holding the real client IP, for example
# CF-Connecting-IP behind Cloudflare. Only set it when every request passes
# through that platform.
TRUSTED_PLATFORM=


# -----------------------------------------------------------------------------
# 3. Rate limits (GCRA in Redis, shared by every replica)
# -----------------------------------------------------------------------------
# Each policy allows RATE_LIMIT_<NAME> requests per RATE_LIMIT_<NAME>_PERIOD,
# with up to RATE_LIMIT_<NAME>_BURST at once. A limit of 0 disables the policy.
#   IP              every /api/v1 request, per client IP
#   AUTH            register, login and refresh, per client IP
#   LOGIN_ACCOUNT   failed logins, per account
#   USER            authenticated requests, per user
#   API_CLIENT      requests with an API key, per client
#   RESUME_UPLOAD   resume uploads, per user
#   CONTACT_ENRICH  enrichment requests, per user (each spends paid credits)
#   AI              AI provider calls, counted in estimated tokens (off by default; see section 9)
RATE_LIMIT_IP=1200
RATE_LIMIT_IP_PERIOD=1m
RATE_LIMIT_IP_BURST=200
RATE_LIMIT_AUTH=10
RATE_LIMIT_AUTH_PERIOD=1m
RATE_LIMIT_AUTH_BURST=10
RATE_LIMIT_LOGIN_ACCOUNT=10
RATE_LIMIT_LOGIN_ACCOUNT_PERIOD=1h
RATE_LIMIT_LOGIN_ACCOUNT_BURST=5
RATE_LIMIT_USER=600
RATE_LIMIT_USER_PERIOD=1m
RATE_LIMIT_USER_BURST=100
RATE_LIMIT_API_CLIENT=1200
RATE_LIMIT_API_CLIENT_PERIOD=1m
RATE_LIMIT_API_CLIENT_BURST=300
RATE_LIMIT_RESUME_UPLOAD=20
RATE_LIMIT_RESUME_UPLOAD_PERIOD=24h
RATE_LIMIT_RESUME_UPLOAD_BURST=10
RATE_LIMIT_CONTACT_ENRICH=30
RATE_LIMIT_CONTACT_ENRICH_PERIOD=24h
RATE_LIMIT_CONTACT_ENRICH_BURST=10
# Open and click tracking and unsubscribe links, per IP. Mail providers fetch
# images for many recipients from shared addresses, so keep this generous.
RATE_LIMIT_PUBLIC_LINK=600
RATE_LIMIT_PUBLIC_LINK_PERIOD=1m
RATE_LIMIT_PUBLIC_LINK_BURST=200
RATE_LIMIT_AI=0
RATE_LIMIT_AI_PERIOD=1m
RATE_LIMIT_AI_BURST=1


# -----------------------------------------------------------------------------
# 4. PostgreSQL 16 with pgvector
# -----------------------------------------------------------------------------
# These defaults match docker-compose.dev.yml (make dev-up).
DB_HOST=localhost
DB_PORT=5432
DB_USER=autoreach
DB_PASSWORD=autoreach
DB_NAME=autoreach
# search_path is set to "<DB_SCHEMA>,public"; the vector extension lives in public.
DB_SCHEMA=autoreach
DB_SSLMODE=disable
DB_MAX_CONNS=20
DB_STATEMENT_TIMEOUT=15s
DB_LOCK_TIMEOUT=5s


# -----------------------------------------------------------------------------
# 5. Redis 7 (task queue, rate limits, locks, counters)
# -----------------------------------------------------------------------------
# These defaults match docker-compose.dev.yml (make dev-up).
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=autoreach
REDIS_DB=0


# -----------------------------------------------------------------------------
# 6. Authentication
# -----------------------------------------------------------------------------
# REQUIRED in every environment. HS256 signing key for access tokens, at least 32
# characters; also signs tracking and unsubscribe links, so changing it breaks
# those links in emails already sent. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# Email verification. When on (the default in production), signup answers the
# same for new and registered addresses, so it cannot reveal who has an account,
# and an account signs in only after its emailed link is opened. Off by default
# elsewhere so local signups work without a mail server. When on, the three
# settings below and SYSTEM_SMTP_HOST are required.
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# The frontend page the link opens; it posts the token parameter to
# POST /api/v1/auth/verify-email.
AUTH_EMAIL_VERIFICATION_URL=
AUTH_EMAIL_VERIFICATION_TTL=48h
# The frontend page a password reset link opens; it posts the token parameter
# and the new password to POST /api/v1/auth/reset-password. Required with
# email verification on.
AUTH_PASSWORD_RESET_URL=
AUTH_PASSWORD_RESET_TTL=1h
# The frontend page an email change link opens; it posts the token and email
# parameters to POST /api/v1/users/me/email/confirm. Required with email
# verification on.
AUTH_EMAIL_CHANGE_URL=
# AutoReach's own sender for account emails (not a candidate's mailbox).
SYSTEM_MAIL_ADDRESS=
SYSTEM_MAIL_NAME=AutoReach
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_SECURITY=STARTTLS
SYSTEM_SMTP_USERNAME=
SYSTEM_SMTP_PASSWORD=


# -----------------------------------------------------------------------------
# 7. Worker and scheduler
# -----------------------------------------------------------------------------
WORKER_MESSAGE_PROVIDER=asynq
# Tasks the worker runs at once.
WORKER_CONCURRENCY=10
# Defaults to WORKER_CONCURRENCY + 5 so every running task can hold a connection.
# WORKER_DB_MAX_CONNS=15
# Must be shorter than the container stop_grace_period (45s in Compose).
WORKER_SHUTDOWN_TIMEOUT=25s
# Embedding tasks are folded into one AI provider call: flush at this many jobs,
# or after MAX_DELAY, or once no new task arrived for GRACE_PERIOD
# (values below 1s are raised to 1s; the queue library rejects less).
WORKER_EMBED_GROUP_MAX_SIZE=64
WORKER_EMBED_GROUP_MAX_DELAY=10s
WORKER_EMBED_GROUP_GRACE_PERIOD=2s
CRON_STOP_GRACE_PERIOD=20s
# Re-enqueues rows whose task was lost (for example a publish that failed
# after the database commit). STALE_AFTER must exceed normal queue latency.
RECONCILER_INTERVAL=5m
RECONCILER_STALE_AFTER=5m
RECONCILER_BATCH_SIZE=500


# -----------------------------------------------------------------------------
# 8. Background concurrency (inside each process)
# -----------------------------------------------------------------------------
# Fire-and-forget work (utils.RunInBackground). When all slots are busy the
# work runs inline on the caller, which applies backpressure.
BACKGROUND_MAX_GOROUTINES=64
# How long shutdown waits for background work before closing the pools.
BACKGROUND_DRAIN_TIMEOUT=15s
# Fan-out width of utils.RunConcurrently. Keep below DB_MAX_CONNS.
CONCURRENT_TASK_LIMIT=16


# -----------------------------------------------------------------------------
# 9. AI provider (embeddings for matching, chat model for resume parsing)
# -----------------------------------------------------------------------------
# Any OpenAI-compatible API works: OpenAI by default, or Gemini, Azure OpenAI,
# OpenRouter, Groq or Ollama by changing AI_BASE_URL and the model names.
# Without a key the app runs, but jobs and resumes cannot be embedded, so no
# matches are produced (embedding tasks fail and end up as dead tasks).
# Changing the embedding model means re-embedding every job and resume, and
# recalibrating MATCH_CALIBRATION_LOW/HIGH (make calibrate).
#
# Gemini example:
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_EMBEDDING_MODEL=gemini-embedding-001
#   AI_CHAT_MODEL=gemini-2.5-flash
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector(1536) columns; the provider must support this size.
AI_EMBEDDING_DIMENSIONS=1536
AI_TIMEOUT=30s
# Free AI plans cap tokens per minute. RATE_LIMIT_AI (with _PERIOD and _BURST, section 4)
# paces calls by estimated tokens (4 characters each) so requests wait instead of being
# rejected; set it a little under the provider's limit, e.g. RATE_LIMIT_AI=25000 for 30,000
# a minute. Waiting tasks come back when the budget refills and do not use up their retries.
# When the provider answers 429, that operation pauses for every worker for the time the
# provider asks (AI_COOLDOWN_DEFAULT when it gives none, never more than AI_COOLDOWN_MAX).
AI_COOLDOWN_DEFAULT=1m
AI_COOLDOWN_MAX=24h
# Inputs are truncated to stay under the model's token limit (8,191 for OpenAI).
AI_EMBEDDING_MAX_INPUT_CHARS=24000
# Chat completion model. Resume parsing uses it with a JSON-schema response to
# extract skills, job titles, experience and education; when the call fails,
# skills come from the fixed skill list instead.
AI_CHAT_MODEL=gpt-4o-mini
RESUME_PARSING_MAX_INPUT_CHARS=24000
RESUME_PARSING_MAX_SKILLS=60


# -----------------------------------------------------------------------------
# 10. Resumes and matching
# -----------------------------------------------------------------------------
# Must stay below HTTP_MAX_BODY_BYTES to leave room for multipart framing.
RESUME_MAX_BYTES=4194304
# Guard against documents that expand to huge text (zip bombs).
RESUME_MAX_TEXT_CHARS=200000
# Jobs considered per resume. EF_SEARCH is raised to at least TOP_K, because
# pgvector returns at most ef_search rows from an HNSW scan (default 40).
MATCH_TOP_K=50
MATCH_EF_SEARCH=100
# Matches scoring below min(candidate threshold, this floor) are not stored.
MATCH_MIN_STORED_SCORE=0.50
# matchScore = clamp((cosineSimilarity - LOW) / (HIGH - LOW), 0, 1).
# 0 and 1 leave the raw similarity unchanged. Set from a labelled sample
# (make calibrate): raw resume-to-job similarity rarely reaches 0.80 with this
# embedding model.
MATCH_CALIBRATION_LOW=0
MATCH_CALIBRATION_HIGH=1


# -----------------------------------------------------------------------------
# 11. Job sources (polled job boards, searches and career pages)
# -----------------------------------------------------------------------------
# Sources are added by an admin through /api/v1/admin/job-sources; external
# feeds can also push jobs to /api/v1/jobs/ingest with an API key.
# How often every active source is read.
JOB_SOURCE_POLL_INTERVAL=1h
# Sources that may not list every open job (Adzuna searches, Workday sites with
# 2000+ postings) close a job only after it has not been seen for this long.
JOB_SOURCE_STALE_AFTER=720h
# Large boards return many megabytes, so board reads get a longer timeout.
JOB_BOARD_HTTP_TIMEOUT=1m
# SmartRecruiters, Workday and career-page sitemaps list jobs without their
# descriptions, so each new job needs one more request. New jobs beyond this
# limit wait for the next poll.
JOB_BOARD_MAX_DETAILS_PER_POLL=100
# Postings read at once from one job board API (SmartRecruiters, Workday); kept
# low because they all go to the same employer's site. Career pages read one at a time.
JOB_BOARD_DETAIL_CONCURRENCY=4
# Greenhouse and Lever boards use the API URLs in section 15.
ASHBY_JOB_BOARD_API_URL=https://api.ashbyhq.com/posting-api
SMARTRECRUITERS_API_URL=https://api.smartrecruiters.com/v1
# %s are the tenant and instance from a Workday source's token.
WORKDAY_HOST_URL_FORMAT=https://%s.%s.myworkdayjobs.com
# Adzuna job search (https://developer.adzuna.com). Adzuna sources fail until
# both keys are set.
ADZUNA_API_URL=https://api.adzuna.com/v1/api
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_RESULTS_PER_PAGE=50
ADZUNA_MAX_PAGES=4
# Adzuna jobs name their company but not its website, so the domain is looked up
# by name (Hunter's Domain Finder is free; Apollo's search costs 1 credit per
# company) and cached. Failed lookups are retried after COMPANY_DOMAIN_RETRY_AFTER.
COMPANY_DOMAIN_LOOKUPS_PER_POLL=50
COMPANY_DOMAIN_RETRY_AFTER=168h
# Sent when reading career pages; robots.txt rules for this agent are obeyed.
CAREER_PAGE_USER_AGENT=AutoReachBot/1.0


# -----------------------------------------------------------------------------
# 12. Contact enrichment (finding recruiters and hiring managers)
# -----------------------------------------------------------------------------
# Providers are tried in this order. A provider without an API key is skipped,
# so with no keys at all, enrichment simply finds nobody.
ENRICHMENT_PROVIDERS=HUNTER,APOLLO,SIGNALHIRE,CONTACTOUT
# Per call. The whole task has 30s, so keep this well below it.
ENRICHMENT_HTTP_TIMEOUT=8s
ENRICHMENT_MAX_CONTACTS_PER_JOB=3
ENRICHMENT_PEOPLE_PER_SEARCH=10
# Contacts already known for a company are reused for this long, so the same
# person is not bought again for every opening at that company.
ENRICHMENT_CONTACT_FRESHNESS=720h
# A provider is paused for COOLDOWN after a 429, or when more than
# FAILURE_RATE of at least MIN_REQUESTS calls in WINDOW returned 5xx.
ENRICHMENT_BREAKER_WINDOW=1m
ENRICHMENT_BREAKER_COOLDOWN=1m
ENRICHMENT_BREAKER_MIN_REQUESTS=20
ENRICHMENT_BREAKER_FAILURE_RATE=0.05
ENRICHMENT_MX_LOOKUP_TIMEOUT=3s

# Each provider: API key, base URL, rate limit per window, calls allowed at once
# before the rest are spaced over the window, and paid lookups per UTC day
# (0 disables the budget).
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/api/v1
APOLLO_RATE_LIMIT=50
APOLLO_RATE_WINDOW=1m
APOLLO_RATE_BURST=10
APOLLO_DAILY_CREDITS=200

# SignalHire answers asynchronously by calling back to PUBLIC_BASE_URL
# (section 1); it is used only when that and the webhook secret are set.
SIGNALHIRE_API_KEY=
SIGNALHIRE_BASE_URL=https://www.signalhire.com/api/v1
SIGNALHIRE_RATE_LIMIT=50
SIGNALHIRE_RATE_WINDOW=1m
SIGNALHIRE_RATE_BURST=10
SIGNALHIRE_DAILY_CREDITS=200
SIGNALHIRE_WEBHOOK_SECRET=

CONTACTOUT_API_KEY=
CONTACTOUT_BASE_URL=https://api.contactout.com/v1
CONTACTOUT_RATE_LIMIT=50
CONTACTOUT_RATE_WINDOW=1m
CONTACTOUT_RATE_BURST=10
CONTACTOUT_DAILY_CREDITS=200

# Hunter finds people at a company by domain and job title and returns their emails
# in the same call, so no second lookup is needed. It charges one credit for every
# email returned (the free plan has 50 a month), so only PEOPLE_PER_SEARCH people are
# asked for per company and DAILY_CREDITS limits what one day can spend. The free
# plan returns at most 10 people per search. It is tried first (ENRICHMENT_PROVIDERS).
HUNTER_API_KEY=
HUNTER_BASE_URL=https://api.hunter.io/v2
HUNTER_RATE_LIMIT=400
HUNTER_RATE_WINDOW=1m
HUNTER_RATE_BURST=20
HUNTER_DAILY_CREDITS=5
HUNTER_PEOPLE_PER_SEARCH=3


# -----------------------------------------------------------------------------
# 13. Email outreach
# -----------------------------------------------------------------------------
# AES-256-GCM keys that encrypt candidates' mailbox passwords, as
# <version>:<base64 32 bytes>, comma-separated. New writes use
# CHANNEL_CREDENTIAL_KEY_VERSION; older versions stay readable, so keys can be
# rotated. Needed before anyone connects a mailbox; required in production.
# Generate a key with: echo "1:$(openssl rand -base64 32)"
CHANNEL_CREDENTIAL_KEYS=
CHANNEL_CREDENTIAL_KEY_VERSION=1
# Unencrypted SMTP/IMAP (security NONE) is for local test servers only and is
# refused in production.
OUTREACH_ALLOW_INSECURE_MAIL=false
# Mailbox servers on private or loopback addresses (a local test server) are
# refused unless this is true, so users cannot make the server probe internal
# hosts. Refused in production.
OUTREACH_ALLOW_PRIVATE_MAIL_HOSTS=false
OUTREACH_MAIL_TIMEOUT=20s
OUTREACH_MAIL_HELO_NAME=localhost
# Emails per sending mailbox per rolling 24 hours (accounts may set a lower cap).
OUTREACH_MAX_DAILY_EMAILS=30
# Emails go out only inside this window, in the candidate's timezone.
OUTREACH_SEND_WINDOW_START_HOUR=9
OUTREACH_SEND_WINDOW_END_HOUR=17
OUTREACH_SEND_ON_WEEKENDS=false
# Random delay added to every scheduled send so emails do not go out in bursts.
OUTREACH_SEND_JITTER=10m
# Contacts emailed per job by automatic outreach.
OUTREACH_CONTACTS_PER_JOB=1
OUTREACH_DISPATCH_INTERVAL=1m
OUTREACH_DISPATCH_BATCH_SIZE=100
# How often every connected inbox is checked for replies and bounces.
OUTREACH_REPLY_SWEEP_INTERVAL=15m
OUTREACH_MAX_SEND_ATTEMPTS=3
OUTREACH_SEND_RETRY_DELAY=15m
# A message left SENDING this long is resolved: back to PENDING if it was never
# handed to SMTP, otherwise FAILED, so nothing is sent twice.
OUTREACH_SENDING_STALE_AFTER=15m


# -----------------------------------------------------------------------------
# 14. LinkedIn outreach
# -----------------------------------------------------------------------------
# "assisted": the app prepares each invite and message, the candidate sends it in
# LinkedIn and confirms it. It is the only provider today; automation adapters
# plug in behind the same interface.
LINKEDIN_PROVIDER=assisted
# Connection requests per candidate per rolling 24 hours, counting invites that
# still wait for the candidate.
LINKEDIN_DAILY_INVITE_LIMIT=20
# A LinkedIn message after an invite waits for the acceptance to be confirmed,
# checking again at this interval, and is cancelled after the wait.
LINKEDIN_ACCEPTANCE_RECHECK=24h
LINKEDIN_ACCEPTANCE_WAIT=720h
LINKEDIN_CAP_RETRY_DELAY=1h


# -----------------------------------------------------------------------------
# 15. Job applications (assisted apply)
# -----------------------------------------------------------------------------
# Public APIs used to read job boards and application forms. Greenhouse
# publishes each job's questions; Lever publishes only the posting, so its forms
# are the standard set.
GREENHOUSE_BOARDS_API_URL=https://boards-api.greenhouse.io/v1
LEVER_POSTINGS_API_URL=https://api.lever.co/v0
LEVER_EU_POSTINGS_API_URL=https://api.eu.lever.co/v0
ATS_HTTP_TIMEOUT=15s
# Requests per minute (and burst) to each application site.
ATS_RATE_LIMIT=30
ATS_RATE_BURST=5
# Employer API keys, as <board token or site>:<key>, comma-separated. Only with
# a key can AutoReach submit an application itself; without one the prepared
# application is handed to the candidate. Leave empty unless an employer gave you
# a key.
GREENHOUSE_BOARD_KEYS=
LEVER_SITE_KEYS=


# -----------------------------------------------------------------------------
# 16. Dashboard
# -----------------------------------------------------------------------------
# The live activity stream checks for new events this often, sends a keep-alive
# comment when idle, and closes after the maximum duration (clients reconnect
# with Last-Event-ID and miss nothing).
ACTIVITY_STREAM_POLL_INTERVAL=5s
ACTIVITY_STREAM_HEARTBEAT=25s
ACTIVITY_STREAM_MAX_DURATION=30m
# Open activity streams allowed per candidate, counted across every server.
ACTIVITY_STREAMS_PER_CANDIDATE=5


# -----------------------------------------------------------------------------
# 17. Privacy
# -----------------------------------------------------------------------------
# Contacts are kept and updated as AutoReach interacts with them. Set a period to
# remove the personal details of contacts not refreshed, messaged or heard from for
# that long (for example 17520h); their outreach history stays for metrics. 0 (the
# default) keeps everything. Erasure requests go through
# DELETE /api/v1/admin/contacts/{contactId} and always delete the person.
CONTACT_RETENTION_PERIOD=0
# How often the retention job runs (it replaces CONTACT_RETENTION_CHECK_INTERVAL,
# which is still read when this is unset).
DATA_RETENTION_CHECK_INTERVAL=24h
# Expired sign-in sessions are deleted this long after they expire.
REFRESH_TOKEN_RETENTION=168h
# Opens, clicks and other outreach events older than this are deleted. 0 keeps
# them; deleting them also removes them from dashboard history.
OUTREACH_EVENT_RETENTION=0
# Contacts are shared by every candidate, and bounces and replies arrive in each
# candidate's own inbox, where they could be faked. A bounce, reply or LinkedIn
# response changes the shared contact (and a bounce suppresses the address for
# everyone) only once this many candidates report the same thing, or an admin
# applies the report. Until then it affects only the candidate who saw it.
CONTACT_SIGNAL_CONFIRMATIONS=2


# -----------------------------------------------------------------------------
# 18. File storage (uploaded resumes)
# -----------------------------------------------------------------------------
# local | s3. With s3, the S3_* settings below are required and startup fails
# if the bucket cannot be reached. Any other value also stops startup.
STORAGE_DRIVER=local
# Used only when STORAGE_DRIVER=local.
STORAGE_LOCAL_DIR=./data/uploads

# Used only when STORAGE_DRIVER=s3.
S3_BUCKET=
S3_REGION=us-east-1
# Leave empty for AWS. Set for S3-compatible services (Cloudflare R2, MinIO).
S3_ENDPOINT=
# Leave both empty to use the AWS default credential chain (IAM role, profile).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and most self-hosted services; false for AWS and R2.
S3_USE_PATH_STYLE=false
# AES256 (S3-managed keys), aws:kms, or empty to rely on the bucket default.
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_TIMEOUT=15s


# -----------------------------------------------------------------------------
# 19. Admin bootstrap
# -----------------------------------------------------------------------------
# Read only by `autoreach create-admin <email>`; pass it on the command line
# rather than storing it here.
# ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# 20. Table name overrides
# -----------------------------------------------------------------------------
# Only needed if a deployment names tables differently: DB_TABLE_<NAME>=<table>.
# DB_TABLE_USERS=users
# DB_TABLE_REFRESH_TOKENS=refresh_tokens
# DB_TABLE_CANDIDATES=candidates
# DB_TABLE_API_CLIENTS=api_clients
# DB_TABLE_JOB_POSTINGS=job_postings
# DB_TABLE_CANDIDATE_RESUMES=candidate_resumes
# DB_TABLE_JOB_MATCHES=job_matches
# DB_TABLE_COMPANY_CONTACTS=company_contacts
# DB_TABLE_JOB_CONTACTS=job_contacts
# DB_TABLE_ENRICHMENT_REQUESTS=enrichment_requests
# DB_TABLE_CANDIDATE_CHANNEL_ACCOUNTS=candidate_channel_accounts
# DB_TABLE_OUTREACH_TEMPLATES=outreach_templates
# DB_TABLE_OUTREACH_CAMPAIGNS=outreach_campaigns
# DB_TABLE_OUTREACH_CAMPAIGN_STEPS=outreach_campaign_steps
# DB_TABLE_OUTREACH_MESSAGES=outreach_messages
# DB_TABLE_OUTREACH_EVENTS=outreach_events
# DB_TABLE_SUPPRESSION_ENTRIES=suppression_entries
# DB_TABLE_APPLICATIONS=applications
# DB_TABLE_JOB_SOURCES=job_sources
# DB_TABLE_COMPANY_DOMAINS=company_domains
# DB_TABLE_ACTIVITY_EVENTS=activity_events
