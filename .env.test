APP_ENV=test
PORT=18080
LOG_DIR=
LOG_LEVEL=error

DB_HOST=localhost
DB_PORT=55432
DB_USER=autoreach
DB_PASSWORD=autoreach
DB_NAME=autoreach_test
DB_SCHEMA=autoreach
DB_SSLMODE=disable
DB_MAX_CONNS=10

REDIS_ADDR=localhost:56379
REDIS_PASSWORD=
REDIS_DB=0

INTERNAL_SHARED_SECRET=test-internal-secret
HTTP_RATE_LIMIT_REQUESTS=1000
JWT_SECRET=test-only-jwt-secret-with-at-least-32-chars
AUTH_RATE_LIMIT_REQUESTS=1000
WORKER_CONCURRENCY=4
WORKER_EMBED_GROUP_MAX_SIZE=8
WORKER_EMBED_GROUP_MAX_DELAY=3s
WORKER_EMBED_GROUP_GRACE_PERIOD=1s
RECONCILER_STALE_AFTER=1ms
OPENAI_API_KEY=test-key
STORAGE_LOCAL_DIR=./tmp/test-uploads
MATCH_MIN_STORED_SCORE=0
